  <decision id="determineAcademicStatus" name="Determine Academic Status">
    <decisionTable id="DecisionTable_0p78err">
      <input id="Input_1" label="Current Status">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text></text>
        </inputExpression>
        <inputValues id="UnaryTests_1edcvc3">
          <text>"Active","Active - Without Enrollment","Inactive - Suspended","Active - Residency","Active - LOA","Inactive - Prolonged Leave","Inactive - AWOL","Graduated","Exited on Good Standing","Exited - Permanent Disqualification"</text>
        </inputValues>
      </input>
      <input id="InputClause_0dhz8wo" label="Event">
        <inputExpression id="LiteralExpression_1ap5xy4" typeRef="Any">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_0gp7wp7" label="Additional Condition" biodi:width="192">
        <inputExpression id="LiteralExpression_0t43i3c" typeRef="Any">
          <text></text>
