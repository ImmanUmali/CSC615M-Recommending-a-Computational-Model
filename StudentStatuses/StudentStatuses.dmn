      </input>
      <output id="Output_1" label="Next Status" typeRef="string">
        <outputValues id="UnaryTests_0sduoan">
          <text>"Active","Active - Without Enrollment","Inactive - Suspended","Active - Residency","Active - LOA","Inactive - Prolonged Leave","Inactive - AWOL","Graduated","Exited on Good Standing","Exited - Permanent Disqualification"</text>
        </outputValues>
      </output>
      <rule id="DecisionRule_1fcf3iy">
        <inputEntry id="UnaryTests_0fo61ea">
          <text>"Active"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0ahc9iv">
          <text>Register residency</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1ukrsc7">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0ue31hx">
          <text>"Active - Residency"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0q32c8s">
        <inputEntry id="UnaryTests_1xxbm2o">
          <text>"Active"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0vbf58u">
          <text>File LOA</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0dv34re">
          <text>LOA ≤ maximum</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0u4y0ob">
          <text>"Active - LOA"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0d4l7ok">
        <inputEntry id="UnaryTests_1r2pngy">
          <text>"Active"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0ivs4zn">
          <text>Did not enroll</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1e6kiqq">
          <text>&gt; 6 trimesters</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0e11j27">
          <text>"Inactive - Prolonged Leave"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_07odm0j">
        <inputEntry id="UnaryTests_1si5qpg">
          <text>"Active"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_05tc1cu">
          <text>Did not enroll</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0lqeufg">
          <text>No LOA + ≤ 6 trimesters</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_10q8b6h">
          <text>"Inactive - AWOL"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1on7nfw">
        <inputEntry id="UnaryTests_0fuo74b">
          <text>"Active - LOA","Inactive - Prolonged Leave","Inactive - AWOL"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1wtj4k8">
          <text>Approved returnee</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1gd6dyy">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0je2mha">
          <text>"Active"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0b6udag">
        <inputEntry id="UnaryTests_19g7ss0">
          <text>"Active"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_08xp6qm">
          <text>Graduation assessment</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0xhielj">
          <text>All programs graduated</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0ys4hbp">
          <text>"Graduated"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
