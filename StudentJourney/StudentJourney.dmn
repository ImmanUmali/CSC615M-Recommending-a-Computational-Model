      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_0q2riu1" name="Determine Student Retention in a Program">
    <decisionTable id="DecisionTable_093sauc">
      <input id="InputClause_1ysehiz" label="Current Status">
        <inputExpression id="LiteralExpression_0hn4m7l" typeRef="string" />
      </input>
      <input id="InputClause_0bi4bac" label="Event">
        <inputExpression id="LiteralExpression_1dtnjb2" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <output id="OutputClause_11fmdgk" label=" Next Status" typeRef="string" />
      <rule id="DecisionRule_1v86vzp">
        <inputEntry id="UnaryTests_0yxzztd">
          <text>P1.0 Eligible</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1lks69j">
          <text>Academic standards complied</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1p4u1j8">
          <text>"Eligible"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0uvf3cb">
        <inputEntry id="UnaryTests_1pm2xd2">
          <text>P1.1 Probationary</text>
        </inputEntry>
        <inputEntry id="UnaryTests_194l4ph">
          <text>Probationary requirements not complied AND Academic standards not complied</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1p8bdeu">
          <text>P1.1 Probationary</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1bp7fll">
        <inputEntry id="UnaryTests_1nbe2ux">
          <text>P1.1 Probationary</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1ofel2j">
          <text>Old student AND Academic standards not complied</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1stuqpi">
          <text>P1.1 Probationary</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0ood92u">
        <inputEntry id="UnaryTests_06qtqet">
          <text>P1.1 Probationary</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1n0vis7">
          <text>Previous status was Probationary AND Strict Probationary requirements not complied AND Academic standards not complied</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0kqqmmw">
          <text>P1.3 Strict Probationary</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0ro1qf4">
        <inputEntry id="UnaryTests_01hfzi3">
          <text>P1.2 SNAS</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0o4175m">
          <text>SNAS criteria not reached</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_11xnpbu">
          <text>P1.0 Eligible</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0u5ug8y">
        <inputEntry id="UnaryTests_0h72maj">
          <text>P1.2 SNAS</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1pz6ha7">
          <text>SNAS criteria reached</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0b4ls92">
          <text>P1.2 SNAS</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1afq92i">
        <inputEntry id="UnaryTests_05fxli5">
          <text>P1.3 Strict Probationary</text>
        </inputEntry>
        <inputEntry id="UnaryTests_10punny">
          <text>Strict Probationary requirements complied</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0hc5p7p">
          <text>P1.1 Probationary</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0uwp3qd">
        <inputEntry id="UnaryTests_1sa3lh2">
          <text>P1.3 Strict Probationary</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1ofezdr">
          <text>Strict Probationary requirements not complied AND Academic standards not complied AND program/strand retention rules breached</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1l5g52f">
          <text>P1.4 Ineligible</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="evaluateExit" name="Evaluate Exit">
    <decisionTable id="DecisionTable_0ho646f">
      <input id="InputClause_0qe5ich" label="Current Status">
        <inputExpression id="LiteralExpression_1grznot" typeRef="string" />
        <inputValues id="UnaryTests_1gos1uu">
          <text>"Active","Active - Without Enrollment","Inactive - Suspended","Active - Residency","Active - LOA","Inactive - Prolonged Leave","Inactive - AWOL","Graduated","Exited on Good Standing","Exited - Permanent Disqualification"</text>
        </inputValues>
      </input>
      <input id="InputClause_0enbpdy" label="Event">
        <inputExpression id="LiteralExpression_1rg0i0w" typeRef="Any">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_02dlrak" label="Additional Condition">
        <inputExpression id="LiteralExpression_1mgoemw" typeRef="Any">
          <text></text>
        </inputExpression>
      </input>
      <output id="OutputClause_1o3durl" label="Next Status" typeRef="string">
        <outputValues id="UnaryTests_10drbny">
          <text>"Active","Active - Without Enrollment","Inactive - Suspended","Active - Residency","Active - LOA","Inactive - Prolonged Leave","Inactive - AWOL","Graduated","Exited on Good Standing","Exited - Permanent Disqualification"</text>
        </outputValues>
      </output>
      <rule id="DecisionRule_1dpy72q">
        <inputEntry id="UnaryTests_11k104n">
          <text>"Active","Active - Without Enrollment","Active - Residency","Active - LOA","Inactive - Prolonged Leave","Inactive - AWOL"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_19bkqfz">
          <text>University exit</text>
        </inputEntry>
        <inputEntry id="UnaryTests_03gu25j">
          <text>Good standing</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1rhxh6y">
          <text>"Exited with GoodStanding"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_1noze7w" name="Assess Graduation Eligibility - Final Check">
    <decisionTable id="DecisionTable_0jtd6oy">
      <input id="InputClause_0eyx41v" label="Current Status">
        <inputExpression id="LiteralExpression_0xgho32" typeRef="string" />
      </input>
      <input id="InputClause_0c67eh9" label="Event">
        <inputExpression id="LiteralExpression_0l92l9b" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <output id="OutputClause_0tob06k" label="Next Status" typeRef="string" />
      <rule id="DecisionRule_0miwtej">
        <inputEntry id="UnaryTests_0g1u3cd">
          <text>P2.0 Candidate for Graduation</text>
        </inputEntry>
        <inputEntry id="UnaryTests_02u8p4i">
          <text>Graduation eligibility rules complied</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_01yesgt">
          <text>P3.0 Graduated</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
